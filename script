(() => {
  "use strict";

  // ---------- Settings ----------
  const LOCK_TITLE = " You are banned for using the SFC script";
  const LOCK_TEXT = "StateFarm Client (SFC) was detected. Turn off your hacks, remove the script and reload the page.";
  const PERSIST_LOCK = false;        // true = stay locked even after a reload (remembered in this browser)
  const SCAN_OTHER_PLAYERS = true;   // also flag chat messages / player names that look like SFC
  const CHECK_EVERY_MS = 2000;       // how often to re-scan
  const THRESHOLD = 3;               // evidence score needed to warn (strong signs are worth 3)
  const BANNER_ID = "anticheat-warning-banner";

  const norm = (s) => String(s || "").normalize("NFKD").replace(/[\u0405\u0455]/g, "s"); // SFC uses a Cyrillic "Ѕ"
  const isNative = (f) => {
    try { return typeof f === "function" && /\[native code\]/.test(Function.prototype.toString.call(f)); }
    catch (e) { return true; }
  };

  // ---------- Banner ----------
  let box = null;
  function getBox() {
    if (box && box.isConnected) return box;
    if (!document.body) return null;
    box = document.createElement("div");
    box.id = BANNER_ID;
    box.style.cssText = "position:fixed;top:0;left:0;right:0;z-index:2147483647;display:flex;flex-direction:column;gap:4px;pointer-events:none";
    document.body.appendChild(box);
    return box;
  }
  function warn(text, color, autoHideMs) {
    const host = getBox();
    if (!host) return false;
    while (host.children.length >= 4) host.firstChild.remove();
    const row = document.createElement("div");
    row.style.cssText = `display:flex;align-items:center;justify-content:center;gap:1em;padding:.7em 1em;background:${color};color:#fff;font:700 17px/1.2 sans-serif;text-align:center;box-shadow:0 .2em .6em rgb(0 0 0 / .5);pointer-events:auto`;
    const span = document.createElement("span");
    span.textContent = text;
    row.append(span);
    host.appendChild(row);
    if (autoHideMs) setTimeout(() => row.remove(), autoHideMs);
    return true;
  }

  // ---------- 1. Is SFC running on this page? ----------
  function findEvidence() {
    let score = 0;
    const reasons = [];
    const add = (pts, why) => { score += pts; reasons.push(why); };

    // Strong signs (taken from the SFC source)
    try { if (document.querySelector(".tp-statefarm")) add(3, "elements with class tp-statefarm"); } catch (e) {}
    try { if (typeof String.prototype.originalReplace === "function" || typeof String.prototype.originalReplaceAll === "function") add(3, "String.prototype.originalReplace patch"); } catch (e) {}
    try { if (window.WASMOBJECT) add(3, "window.WASMOBJECT (WebAssembly hook)"); } catch (e) {}
    try { if (window.globalSS) add(3, "window.globalSS (SFC debug object)"); } catch (e) {}
    try { if (document.getElementById("sfChat-iframe") || document.querySelector('iframe[src*="StateFarmClient" i]')) add(3, "SFC chat iframe"); } catch (e) {}
    try { if (document.getElementById("automated-border")) add(3, "SFC bot window border"); } catch (e) {}
    try { if (/state\s*farm/i.test(norm(document.title))) add(3, "page title mentions StateFarm"); } catch (e) {}
    try { if (document.querySelector('img[src*="StateFarmClient" i],img[src*="shell-logo-replacement" i],img[src*="sfc.best" i]')) add(3, "SFC logo / badge images"); } catch (e) {}

    // Medium signs (need to add up with something else)
    try { if (document.querySelector("#minimap.MiniMap") && document.querySelector(".playerDot")) add(2, "SFC minimap elements"); } catch (e) {}
    try {
      const scrambled = Object.getOwnPropertyNames(window).filter((k) => {
        if (!/^[a-z]{10}$/.test(k)) return false;
        try { return typeof window[k] === "function"; } catch (e) { return false; }
      });
      if (scrambled.length >= 5) add(2, `${scrambled.length} random 10-letter global functions`);
    } catch (e) {}
    try { if (document.querySelector(".tp-rotv")) add(1, "Tweakpane menu present"); } catch (e) {}
    try {
      if (window.WebAssembly && !isNative(WebAssembly.instantiateStreaming)) add(1, "WebAssembly.instantiateStreaming replaced");
      if (!isNative(EventTarget.prototype.addEventListener)) add(1, "addEventListener replaced");
      if (!isNative(HTMLElement.prototype.appendChild)) add(1, "appendChild replaced");
    } catch (e) {}

    return { score, reasons };
  }

  // ---------- Lock screen (cannot be closed) ----------
  const LOCK_ID = "anticheat-lock-screen";
  const STORE_KEY = "anticheat_sfc_locked";
  let locked = false;

  function buildLock() {
    const o = document.createElement("div");
    o.id = LOCK_ID;
    o.style.cssText = "position:fixed;inset:0;z-index:2147483647;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.8em;background:#000;color:#fff;font-family:sans-serif;text-align:center;padding:2em;cursor:not-allowed;user-select:none";
    const h = document.createElement("div");
    h.textContent = LOCK_TITLE;
    h.style.cssText = "font:800 clamp(28px,5vw,64px)/1.1 sans-serif;color:#ff3b3b";
    const p = document.createElement("div");
    p.textContent = LOCK_TEXT;
    p.style.cssText = "font:600 clamp(16px,2vw,24px)/1.3 sans-serif;color:#ddd;max-width:40em";
    o.append(h, p);
    return o;
  }

  // Stops the game from receiving keys / mouse while locked (reload and dev tools keys still work)
  const BLOCKED = ["keydown", "keyup", "keypress", "mousedown", "mouseup", "click", "dblclick", "contextmenu", "wheel", "mousemove", "pointerdown", "pointerup", "pointermove", "touchstart", "touchmove", "touchend"];
  function blockInput(e) {
    if (e.type === "keydown" || e.type === "keyup") {
      const k = (e.key || "").toLowerCase();
      if (k === "f5" || k === "f12" || ((e.ctrlKey || e.metaKey) && k === "r")) return;
    }
    e.stopImmediatePropagation();
    e.preventDefault();
  }

  function lock(reasons, score) {
    if (locked) return true;
    if (!document.body) return false;
    locked = true;
    if (reasons) console.warn("[Anti-Cheat] SFC detected (score " + score + "):", reasons);
    try { if (PERSIST_LOCK) localStorage.setItem(STORE_KEY, "1"); } catch (e) {}

    const mount = () => {
      if (!document.getElementById(LOCK_ID) && document.body) document.body.appendChild(buildLock());
      document.documentElement.style.overflow = "hidden";
      try { document.exitPointerLock(); } catch (e) {}
    };
    mount();
    BLOCKED.forEach((t) => window.addEventListener(t, blockInput, { capture: true, passive: false }));
    setInterval(mount, 250); // puts the screen back if someone deletes it
    return true;
  }

  function checkSelf() {
    if (locked) return;
    let remembered = false;
    try { remembered = PERSIST_LOCK && localStorage.getItem(STORE_KEY) === "1"; } catch (e) {}
    if (remembered) { lock(); return; }
    const { score, reasons } = findEvidence();
    if (score >= THRESHOLD) lock(reasons, score);
  }

  // ---------- 2. Do other players look like they use SFC? ----------
  const SIGNATURE = /state\s*farm|dsc\.gg\/sfnetwork|\[sfc\]|\bsfc\b/i;
  const doneChat = new WeakSet();
  const flagged = new Set();
  function flag(key, text) {
    if (flagged.has(key)) return;
    if (warn(text, "#c25b00", 12000)) flagged.add(key);
  }
  function checkOthers() {
    try {
      document.querySelectorAll("#chatOut .chat-item").forEach((el) => {
        if (doneChat.has(el)) return;
        doneChat.add(el);
        if (SIGNATURE.test(norm(el.textContent))) {
          const name = (el.querySelector(".chat-player-name")?.textContent || "A player").trim();
          flag("chat:" + name, ` ${name} sent an SFC message. Looks like StateFarm Client: use off hacks!`);
        }
      });
      document.querySelectorAll("#playerList .playerSlot--name").forEach((el) => {
        const name = el.textContent.trim();
        if (name && SIGNATURE.test(norm(name))) {
          flag("name:" + name, ` Player "${name}" has an SFC-style name. Looks like StateFarm Client: use off hacks!`);
        }
      });
    } catch (e) {}
  }

  // ---------- Run ----------
  const scan = () => { checkSelf(); if (SCAN_OTHER_PLAYERS) checkOthers(); };
  scan();
  document.addEventListener("DOMContentLoaded", scan, { once: true });
  window.addEventListener("load", scan, { once: true });
  setInterval(scan, CHECK_EVERY_MS);

  let timer = null;
  const startObserver = () => new MutationObserver(() => {
    clearTimeout(timer);
    timer = setTimeout(scan, 300);
  }).observe(document.documentElement, { childList: true, subtree: true });
  document.documentElement ? startObserver() : document.addEventListener("DOMContentLoaded", startObserver, { once: true });
})();
